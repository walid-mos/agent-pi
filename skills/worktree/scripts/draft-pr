#!/usr/bin/env bash
set -euo pipefail

usage='usage: draft-pr <checkout> <repository-format title> --description <public Markdown> [base branch]'
refuse() {
	printf 'draft-pr: %s\n%s\n' "$1" "$usage" >&2
	exit 2
}

if [[ $# -lt 2 || -z $1 || -z $2 ]]; then
	refuse 'a checkout and a title are required'
fi
if [[ ${3-} != --description ]]; then
	refuse "--description <public Markdown> must follow the title${3+, got '$3'}"
fi
description=${4-}
if [[ -z ${description//[[:space:]]/} ]]; then
	refuse '--description is missing or blank: write the public purpose, intended behavior and planned checks'
fi
if [[ $# -gt 5 ]]; then
	refuse "only one base branch may follow the description, got $(($# - 4)) arguments"
fi
checkout=$1
title=$2
cd "$checkout"

branch=$(git branch --show-current)
if [[ -z $branch ]]; then
	echo "draft-pr: $checkout has a detached HEAD; create the task branch first" >&2
	exit 1
fi

open_pull_request=$(gh pr list --head "$branch" --state open --json url --jq '.[0].url // empty')
if [[ -n $open_pull_request ]]; then
	echo "$open_pull_request"
	exit 0
fi

base=${5:-$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name)}
git fetch --quiet origin "$base"

if [[ $(git rev-list --count "origin/$base..HEAD") == 0 ]]; then
	# GitHub requires a commit before opening a pull request.
	git commit --quiet --allow-empty -m "$title"
fi
git push --quiet -u origin "$branch"

gh pr create --draft --base "$base" --head "$branch" --title "$title" --body "$description"
