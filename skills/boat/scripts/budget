#!/usr/bin/env python3
import argparse
from decimal import Decimal, InvalidOperation, ROUND_CEILING
import json
import subprocess

DAILY_BUDGET_DOLLARS = Decimal("2")
SIMULTANEOUS_CHECKS = 2
MICRODOLLAR = Decimal("0.000001")
LIMITS_COMMAND = ("boat", "--no-update", "limits", "--all", "--json")


class BudgetCheckError(Exception):
    pass


def field(limits, key):
    value = limits
    for part in key.split("."):
        if not isinstance(value, dict) or part not in value:
            raise BudgetCheckError(f"missing limits field {key}")
        value = value[part]
    return value


def number(value, label, allowed_types):
    if type(value) not in allowed_types or not Decimal(value).is_finite() or value < 0:
        raise BudgetCheckError(f"{label} must be a finite nonnegative number")
    return value


def count(limits, key):
    return number(field(limits, key), key, (int,))


def fee(value, label):
    return Decimal(number(value, label, (int, Decimal)))


def fee_ceiling(limits):
    key = "overagePrices.startBrackets"
    brackets = field(limits, key)
    if not isinstance(brackets, list) or not brackets:
        raise BudgetCheckError(f"{key} must contain the start fee brackets")
    return max(fee(field(bracket, "dollars"), key) for bracket in brackets)


def decision(limits, maximum_charge, remainder, simultaneous_checks):
    can_start = field(limits, "canStart")
    if type(can_start) is not bool:
        raise BudgetCheckError("canStart must be a boolean")
    if not can_start or field(limits, "nextStartDollars") is None:
        return "provider-blocked"
    if count(limits, "activeSandboxes") or count(limits, "liveUsageSeconds"):
        return "busy"
    if maximum_charge > remainder:
        return "over-budget"
    if maximum_charge * simultaneous_checks > remainder:
        return "contended"
    return "fits"


def compute_bound(limits, highest_hourly_price):
    seconds_per_dollar = count(limits, "creditSecondsPerDollar")
    if not seconds_per_dollar:
        raise BudgetCheckError("creditSecondsPerDollar must be positive")
    seconds = Decimal(count(limits, "last24hUsageSeconds"))
    raw_seconds_cost = seconds * highest_hourly_price / 3600
    credit_seconds_cost = seconds / seconds_per_dollar
    return max(raw_seconds_cost, credit_seconds_cost).quantize(MICRODOLLAR, rounding=ROUND_CEILING)


def check(limits, maximum_runtime, highest_hourly_price, simultaneous_checks):
    rolling_compute = compute_bound(limits, highest_hourly_price)
    max_fee = fee_ceiling(limits)
    rolling_fee_bound = count(limits, "starts.day.used") * max_fee
    remainder = max(Decimal(0), DAILY_BUDGET_DOLLARS - rolling_compute - rolling_fee_bound)
    next_fee = field(limits, "nextStartDollars")
    if next_fee is not None and fee(next_fee, "nextStartDollars") > max_fee:
        raise BudgetCheckError("nextStartDollars exceeds the start fee brackets")
    maximum_charge = maximum_runtime + max_fee
    return {
        "decision": decision(limits, maximum_charge, remainder, simultaneous_checks),
        "rollingComputeBoundDollars": dollars(rolling_compute),
        "rollingStartFeeBoundDollars": dollars(rolling_fee_bound),
        "remainderDollars": dollars(remainder),
        "maximumChargeDollars": dollars(maximum_charge),
    }


def dollars(amount):
    return format(amount.normalize(), "f")


def read_limits():
    try:
        reply = subprocess.run(LIMITS_COMMAND, capture_output=True, check=True, timeout=30)
        return json.loads(reply.stdout, parse_float=Decimal)
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        raise BudgetCheckError("could not read Boat limits; check sign-in and retry") from error


def main():
    parser = argparse.ArgumentParser(description=f"Check the standing Boat budget of USD {DAILY_BUDGET_DOLLARS}.")
    parser.add_argument("maximum_runtime_dollars", type=Decimal)
    parser.add_argument("--highest-hourly-dollars", type=Decimal, required=True)
    parser.add_argument("--serialized", action="store_true", help="All callers have reserved an exclusive account start slot.")
    arguments = parser.parse_args()
    simultaneous_checks = 1 if arguments.serialized else SIMULTANEOUS_CHECKS
    try:
        maximum_runtime = number(arguments.maximum_runtime_dollars, "maximum runtime dollars", (Decimal,))
        if maximum_runtime <= 0 or maximum_runtime != maximum_runtime.quantize(MICRODOLLAR):
            raise BudgetCheckError("round positive maximum runtime dollars up to six decimal places")
        highest_hourly_price = number(arguments.highest_hourly_dollars, "highest hourly price", (Decimal,))
        if highest_hourly_price <= 0:
            raise BudgetCheckError("highest hourly price must be positive")
        print(json.dumps(check(read_limits(), maximum_runtime, highest_hourly_price, simultaneous_checks)))
    except (BudgetCheckError, InvalidOperation) as error:
        parser.exit(1, f"budget: {error}\n")


if __name__ == "__main__":
    main()
