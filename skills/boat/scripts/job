#!/usr/bin/env bash
set -euo pipefail

fail() { echo "job: $1" >&2; exit 1; }

scripts=$(dirname "$0")
command -v workspace >/dev/null || fail "workspace is missing: run $scripts/install first"
if [[ $(uname -s) == Darwin ]]; then
	exec python3 -B "$scripts/job-launch.py" "$@"
fi
exec /opt/agent-sandbox/session/with-vault --with boat python3 -B "$scripts/job-launch.py" "$@"
