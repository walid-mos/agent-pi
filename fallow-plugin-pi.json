{
	"name": "pi-agent-runtime",
	"enablers": ["@earendil-works/pi-coding-agent"],
	"entryPointRole": "support",
	"entryPoints": [
		"bin/setup.ts",
		"bin/lib/pi-token.mjs",
		"extensions/*/*/index.ts",
		"skills/advisored/scripts/advisor.ts"
	],
	"usedClassMembers": [
		{ "implements": "Component", "members": ["invalidate"] },
		{ "implements": "Focusable", "members": ["focused"] }
	],
	"usedExports": [
		{ "pattern": "extensions/*/*/index.ts", "exports": ["default"] }
	]
}
